{
  "name": "oremedia",
  "version": "0.1.0",
  "private": true,
  "description": "Oremedia: multi-company brand studio and social publishing platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:cross-tenant": "vitest run --project cross-tenant",
    "test:all": "vitest run",
    "check:schema": "tsx tooling/scripts/check-schema-tenancy.ts",
    "check:boundaries": "eslint . --max-warnings=0 --rule '{\"boundaries/element-types\": \"error\"}'",
    "check:secrets": "tsx tooling/scripts/check-secrets.ts",
    "check:openapi": "tsx tooling/scripts/check-openapi-diff.ts",
    "db:generate": "pnpm --filter @oremedia/db db:generate",
    "db:migrate": "pnpm --filter @oremedia/db db:migrate",
    "progress:build": "node docs/progress/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-oremedia": "workspace:*",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4",
    "@oremedia/db": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "type": "module"
}
