{
  "title": "Oremedia SLOs (spec 17.2)",
  "uid": "oremedia-slos",
  "description": "Up / fast / erroring / keeping up per journey. Generated from the metric names in packages/observability/src/telemetry.ts; see docs/operations/slos.md. Thresholds are spec 17.2 placeholders until the pilot measures real traffic.",
  "tags": ["oremedia", "slo"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Schedule: up / fast / erroring / keeping up",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "[up] Schedule calls per minute",
      "description": "up: oremedia.http.requests. Runbook: docs/runbooks/deploy-railway.md",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "oremediaJourney": "schedule",
      "oremediaQuestion": "up",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(oremedia_http_requests_total{path=\"/trpc/publishing.publications.schedule\"}[5m])) * 60",
          "oremediaMetric": "oremedia.http.requests"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "[fast] Schedule p95 latency",
      "description": "fast: oremedia.http.duration_ms. Threshold 400 (ms), spec 17.2 placeholder.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "oremediaJourney": "schedule",
      "oremediaQuestion": "fast",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oremedia_http_duration_ms_bucket{path=\"/trpc/publishing.publications.schedule\"}[5m])))",
          "oremediaMetric": "oremedia.http.duration_ms"
        }
