# apps/web: static SPA build served by Caddy (immutable assets, SPA fallback, security headers).
# syntax=docker/dockerfile:1.7
FROM node:22.22.2-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
# pnpm is installed from the registry (npm verifies integrity); corepack in this Node image carries a rotated-out signing key.
RUN npm install -g pnpm@10.6.1 && npm cache clean --force
WORKDIR /src
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc turbo.json tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY tooling ./tooling
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
ARG VITE_API_ORIGIN
ARG VITE_REVIEW_PORTAL_ORIGIN
RUN pnpm --filter @oremedia/web build

FROM caddy:2.9-alpine AS runtime
COPY infra/railway/web/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/apps/web/dist /srv
