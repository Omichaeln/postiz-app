# worker-render: isolated rendering with headless Chromium (spec 11.5). No credential access; egress restricted
# at the network layer (Railway private networking + object-store endpoint only).
# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/playwright:v1.63.0-noble AS base
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*

FROM base AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
# pnpm is installed from the registry (npm verifies integrity); corepack in this Node image carries a rotated-out signing key.
RUN npm install -g pnpm@10.6.1 && npm cache clean --force
WORKDIR /src
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc turbo.json tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY tooling ./tooling
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
# The render-only bundle of the shared Konva scene (spec 11.5) is built first; the worker build copies it beside
# the workflow bundles and fails loudly if it is missing.
RUN pnpm --filter @oremedia/editor build:renderer && pnpm --filter @oremedia/worker-render build
RUN rm -rf node_modules apps/*/node_modules packages/*/node_modules packages/modules/*/node_modules tooling/*/node_modules \
  && pnpm install --prod --frozen-lockfile --filter "@oremedia/worker-render..." --config.node-linker=hoisted

FROM base AS runtime
ENV NODE_ENV=production OREMEDIA_SERVICE=oremedia-worker-render
# The runtime never installs packages: npm and corepack are removed (least privilege; their bundled dependencies
# are what the container scan otherwise flags).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY --from=build --chown=pwuser:pwuser /src/node_modules ./node_modules
COPY --from=build --chown=pwuser:pwuser /src/apps/worker-render/dist ./dist
COPY --from=build --chown=pwuser:pwuser /src/apps/worker-render/package.json ./package.json
USER pwuser
CMD ["node", "dist/main.js"]
