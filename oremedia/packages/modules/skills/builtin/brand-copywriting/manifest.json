{
  "schemaVersion": 1,
  "key": "brand-copywriting",
  "title": "Brand copywriting",
  "description": "Writes caption variants for a brief from the brand snapshot and approved facts, with a rationale and fact references per variant. Variants are drafts; claims and prohibited-term checks gate them.",
  "taskKinds": ["copywriting"],
  "inputSchema": {
    "type": "object",
    "properties": {
      "briefId": { "type": "string" },
      "brief": {
        "type": "object",
        "properties": {
          "objective": { "type": "string" },
          "audience": { "type": "string" },
          "keyMessages": { "type": "array", "items": { "type": "string" } },
          "channelKey": { "type": "string" },
          "locale": { "type": "string" }
        },
        "required": ["objective", "audience", "keyMessages", "channelKey", "locale"]
      },
      "variantCount": { "type": "integer", "minimum": 1, "maximum": 6 },
      "tone": { "type": "string", "maxLength": 200 }
    },
    "required": ["brief", "variantCount"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "variants": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "channelKey": { "type": "string" },
            "text": { "type": "string", "maxLength": 3000 },
            "rationale": { "type": "string", "maxLength": 1000 },
            "factIds": { "type": "array", "items": { "type": "string" } },
            "hashtags": { "type": "array", "items": { "type": "string" } },
            "cta": { "type": "string" }
          },
          "required": ["id", "channelKey", "text", "rationale", "factIds"]
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "severity": { "enum": ["blocking", "warning", "note"] },
            "code": { "type": "string" },
            "message": { "type": "string" },
            "variantId": { "type": "string" }
          },
          "required": ["severity", "code", "message"]
        }
      }
    },
    "required": ["variants", "findings"]
  },
  "requiredContext": ["brand_snapshot", "approved_facts", "customer_voice"],
  "allowedTools": ["brand.getSnapshot", "facts.list", "content.draftCopy", "review.runBrandReview"],
  "budgets": {
    "maxSteps": 16,
    "maxTokens": 60000,
    "maxCostMicros": 800000,
    "maxVariants": 6,
    "deadlineSeconds": 300
  },
  "modelCompatibility": ["anthropic:*"],
  "instructionsPath": "SKILL.md"
}
