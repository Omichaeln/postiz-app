{
  "provider": "instagram_business",
  "scenarios": {
    "exchange": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "graph.facebook.com",
            "path": "/v25.0/oauth/access_token",
            "query": { "code": "code_1" }
          },
          "response": {
            "status": 200,
            "json": { "access_token": "short_fake", "token_type": "bearer" }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "graph.facebook.com",
            "path": "/v25.0/oauth/access_token",
            "query": { "grant_type": "fb_exchange_token" }
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "long_user_fake",
              "token_type": "bearer",
              "expires_in": 5183944
            }
          }
        },
        {
          "request": { "method": "GET", "host": "graph.facebook.com", "path": "/v25.0/me/permissions" },
          "response": {
            "status": 200,
            "json": {
              "data": [
                { "permission": "instagram_basic", "status": "granted" },
                { "permission": "instagram_content_publish", "status": "granted" },
                { "permission": "instagram_manage_comments", "status": "granted" },
                { "permission": "instagram_manage_insights", "status": "granted" },
                { "permission": "pages_show_list", "status": "granted" },
                { "permission": "pages_read_engagement", "status": "granted" },
                { "permission": "business_management", "status": "granted" }
              ]
            }
          }
        },
        {
          "request": { "method": "GET", "host": "graph.facebook.com", "path": "/v25.0/me" },
          "response": { "status": 200, "json": { "id": "u_1", "name": "Ada" } }
        },
        {
          "request": { "method": "GET", "host": "graph.facebook.com", "path": "/v25.0/me/accounts" },
          "response": {
            "status": 200,
            "json": {
              "data": [
                { "id": "p_200", "name": "No IG Page", "access_token": "page_200_fake" },
                {
                  "id": "p_100",
                  "name": "Ore Media",
                  "access_token": "page_100_fake",
                  "instagram_business_account": { "id": "ig_900", "username": "oremedia" }
                }
              ]
            }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "graph.facebook.com",
            "path": "/v25.0/oauth/access_token",
            "query": { "grant_type": "fb_exchange_token", "fb_exchange_token": "long_user_fake" }
          },
          "response": {
            "status": 200,
            "json": { "access_token": "long_user_2_fake", "expires_in": 5183944 }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": { "method": "GET", "host": "graph.facebook.com", "path": "/v25.0/oauth/access_token" },
          "response": {
            "status": 400,
            "json": {
              "error": {
                "message": "Error validating access token: The session has been invalidated because the user changed their password.",
                "type": "OAuthException",
                "code": 190,
                "error_subcode": 460
              }
            }
          }
        }
      ]
    }
  }
}
