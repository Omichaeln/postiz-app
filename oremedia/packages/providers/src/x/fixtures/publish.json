          "response": { "status": 200, "json": { "data": { "id": "m_v", "expires_after_secs": 86400 } } }
        },
        {
          "request": { "method": "POST", "host": "api.x.com", "path": "/2/media/upload/m_v/append" },
          "response": { "status": 204 }
        },
        {
          "request": { "method": "POST", "host": "api.x.com", "path": "/2/media/upload/m_v/finalize" },
          "response": {
            "status": 200,
            "json": {
              "data": { "id": "m_v", "processing_info": { "state": "pending", "check_after_secs": 4 } }
            }
          }
        }
      ]
    },
    "rejected_validation": {
      "exchanges": [
        {
          "request": { "method": "POST", "host": "api.x.com", "path": "/2/tweets" },
          "response": {
            "status": 400,
            "json": {
