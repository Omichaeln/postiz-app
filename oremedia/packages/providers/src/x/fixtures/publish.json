{
  "provider": "x",
  "scenarios": {
    "text_success": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/tweets",
            "bodyIncludes": ["\"text\":\"Hello from Oremedia #launch\""]
          },
          "response": {
            "status": 201,
            "json": { "data": { "id": "1900000000000000001", "text": "Hello from Oremedia #launch" } }
          }
        }
      ]
    },
    "image_success": {
      "exchanges": [
        {
          "request": { "method": "GET", "host": "media.oremedia.test", "path": "/release/img1.jpg" },
          "response": { "status": 200, "body": "JPEGBYTES-0123456789" }
        },
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/media/upload/initialize",
            "bodyIncludes": [
              "\"media_type\":\"image/jpeg\"",
              "\"total_bytes\":20",
              "\"media_category\":\"tweet_image\""
            ]
          },
          "response": {
            "status": 200,
            "json": { "data": { "id": "m_1", "media_key": "3_m_1", "expires_after_secs": 86400 } }
          }
        },
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/media/upload/m_1/append",
            "bodyIncludes": ["name=\"segment_index\"", "JPEGBYTES-0123456789"]
          },
          "response": { "status": 204 }
        },
        {
          "request": { "method": "POST", "host": "api.x.com", "path": "/2/media/upload/m_1/finalize" },
          "response": { "status": 200, "json": { "data": { "id": "m_1", "media_key": "3_m_1" } } }
        },
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/media/metadata",
            "bodyIncludes": ["\"alt_text\":{\"text\":\"A launch banner\"}"]
          },
          "response": { "status": 200, "json": { "data": { "id": "m_1" } } }
        },
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/tweets",
            "bodyIncludes": ["\"media\":{\"media_ids\":[\"m_1\"]}"]
          },
          "response": { "status": 201, "json": { "data": { "id": "1900000000000000002" } } }
        }
      ]
    },
    "video_pending": {
      "exchanges": [
        {
          "request": { "method": "GET", "host": "media.oremedia.test", "path": "/release/clip.mp4" },
          "response": { "status": 200, "body": "MP4BYTES" }
